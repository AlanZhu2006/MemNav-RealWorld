  "navigation_contract": {
    "protocol_version": 3,
    "sensor_contract": "causal_monocular_rgb_v1",
    "policy_depth_source": "monocular_sidecar",
    "metric_depth_sensor_consumed_by_policy": false,
    "client_depth_field": "accepted_for_wire_compatibility_and_discarded",
    "robot_local_depth_role": "collision_safety_and_optional_arrival_audit_only",
    "controller": "frozen_navdp",
    "memory_method": "certified_episodic_compass",
    "controller_radius_m": 2.5,
    "episode_phases": {
      "order": [
        "memory_recording",
        "revisit_query"
      ],
      "initial_phase_after_reset": "memory_recording",
      "phase_switch_endpoint": "/begin_revisit",
      "goal_query_during_recording": "rejected_http_400_no_upstream_traffic",
      "reason": "the first goal query freezes the MemNav goal session and candidate ceiling; issuing it from frame 0 excludes the entire recorded history from Revisit candidacy (2026-08-21 field failure: no_causal_candidate on a valid 613-frame memory)"
    },
    "endpoints": {
      "/navigator_reset": "atomic dual reset; enters memory_recording",
      "/memory_step": "recording phase only; record-only causal RGB append to the shared LingBot stream; transport failure latches memory_degraded",
      "/goal_candidate": "recording phase only; registers a goal-candidate photo that is never appended to memory (captured_after_frame + sha256 receipt)",
      "/begin_revisit": "requires >=1 recorded frame; replays a stride-8 tail of recorded frames through NavDP /memory_replay_step and hard-verifies queue_lengths before entering revisit_query; any warm-up failure latches native_state_uncertain",
      "/imagegoal_step": "revisit_query phase only; goal-conditioned planning",
      "/healthz": "reports phase, frames_recorded, revisit_started_after_frame, goal_candidates_captured"
    },
    "navdp_warmup": {
      "max_frames": 8,
      "stride": 8,
      "mirrors": "simulator shared-trace replay (one plan per exec_horizon=8)",
      "receipt_fields": [
        "navdp_warmup_frames",
        "navdp_warmup_frame_indices",
        "navdp_queue_lengths",
        "navdp_memory_size"
      ],
      "failure_semantics": "native_state_uncertain_reset_required"
    }
  },
  "robot": {
    "platform": "Unitree Go2",
    "compute": "Jetson Orin NX 16GB",
    "camera": "Intel RealSense D435i",
    "ros_distribution": "Humble",
    "uses_vio": false,
    "uses_metric_global_map": false
  },
