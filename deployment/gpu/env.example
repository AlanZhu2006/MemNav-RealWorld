# Copy to deployment/gpu/.env and replace every /path/to entry.
# This file contains paths only; do not put credentials here.

# Python environment shared by the GPU services.
MEMNAV_PY=/path/to/conda/envs/memnav/bin/python

# External MemNav research workspace. Model weights are not distributed here.
MEMNAV_SOURCE_ROOT=/path/to/Nav-graph-blind
# Required source contract: the workspace must include protocol-v2 CEC and
# /monocular_depth_query support (research source commit 70387b6 or later).
MEMNAV_CKPT=/path/to/memnav.ckpt
INTERNNAV_ROOT=/path/to/Nav-graph-blind/InternNav
LINGBOT_REPO=/path/to/lingbot-map
LINGBOT_WEIGHTS=/path/to/lingbot-map/weights/lingbot-map-long.pt
LIGHTGLUE_REPO=/path/to/LightGlue
DEPENDENCY_ROOT=/path/to/python-dependencies

# Frozen NavDP ImageGoal checkpoint from the upstream project.
NAVDP_CKPT=/path/to/navdp_pretrain.ckpt

# REQUIRED: measure the installed D435i optical-center height from the floor.
# There is intentionally no default; do not copy the health-smoke value.
# CEC_CAMERA_HEIGHT_M=0.000

# Optional overrides.
# MEMNAV_SERVER=/path/to/memnav_server.py
# MEMNAV_PORT=18888
# NAVDP_PORT=8888
# CEC_HUB_PORT=18889
# CEC_OUT_ROOT=/path/to/runtime-output
# Frozen online goal-selection contract.
# CEC_GOAL_SCORE_STRIDE=8
# CEC_GOAL_MIN_FRAME_GAP=16
# CEC_GOAL_MIN_INLIERS=16
# CEC_GOAL_MAX_COS=0.90
