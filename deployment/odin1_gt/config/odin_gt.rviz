Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Odin1 Reference1
      Splitter Ratio: 0.55
    Tree Height: 720
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.45
          Cell Size: 0.5
          Class: rviz_default_plugins/Grid
          Color: 110; 115; 125
          Enabled: true
          Line Style:
            Line Width: 0.02
            Value: Lines
          Name: Metric Grid
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 40
          Reference Frame: <Fixed Frame>
          Value: true
        - Alpha: 0.85
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 8
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Odin SLAM Cloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.02
          Style: Points
          Topic:
            Depth: 2
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /odin1/cloud_slam
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.3
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.3
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 500
          Name: Odin Odometry
          Position Tolerance: 0.1
          Shape:
            Alpha: 1
            Axes Length: 0.4
            Axes Radius: 0.04
            Color: 255; 25; 0
            Head Length: 0.1
            Head Radius: 0.05
            Shaft Length: 0.3
            Shaft Radius: 0.03
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /odin1/odometry
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 190; 30
          Enabled: true
          Head Diameter: 0.08
          Head Length: 0.10
          Length: 0.12
          Line Style: Lines
          Line Width: 0.04
          Name: Odin Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 140; 0
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.025
          Shaft Length: 0.08
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /odin1/path
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: TF / Relocalization
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Tree: {}
          Update Interval: 0
          Value: true
      Enabled: true
      Name: Odin1 Reference
  Enabled: true
  Global Options:
    Background Color: 30; 32; 36
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: true
  Width: 1500
  X: 20
  Y: 20
