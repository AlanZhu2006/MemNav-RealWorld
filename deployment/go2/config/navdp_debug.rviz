Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /NavDP Debug1
      Splitter Ratio: 0.55
    Tree Height: 720
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.45
          Cell Size: 0.5
          Class: rviz_default_plugins/Grid
          Color: 110; 115; 125
          Enabled: true
          Line Style:
            Line Width: 0.02
            Value: Lines
          Name: Local Grid (0.5 m)
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 16
          Reference Frame: <Fixed Frame>
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Candidates / Goal / Status
          Namespaces:
            {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /navdp/debug/markers
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 70
          Enabled: true
          Head Diameter: 0.08
          Head Length: 0.10
          Length: 0.12
          Line Style: Lines
          Line Width: 0.05
          Name: Selected Trajectory
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 80; 255; 255
          Pose Style: Arrows
          Radius: 0.03
          Shaft Diameter: 0.025
          Shaft Length: 0.08
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /navdp/trajectory
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: RGB Camera
          Normalize Range: true
          Topic:
            Depth: 2
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /camera/camera/color/image_raw
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 4000
          Median window: 5
          Min Value: 200
          Name: Aligned Depth
          Normalize Range: true
          Topic:
            Depth: 2
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /camera/camera/aligned_depth_to_color/image_raw
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Image Goal
          Normalize Range: true
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /navdp/image_goal
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: ImageGoal Visual Match
          Normalize Range: true
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /navdp/imagegoal_match_debug
          Value: true
      Enabled: true
      Name: NavDP Debug
  Enabled: true
  Global Options:
    Background Color: 30; 32; 36
    Fixed Frame: navdp_local
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 180
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 1.0
      Y: 0.0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: true
  Width: 1500
  X: 20
  Y: 20
