[Unit]
Description=MemNav observer RealSense RGB-D
PartOf=memnav-observer.target
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash %h/MemNav-RealWorld/deployment/go2/scripts/run_observer_component.sh camera
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=memnav-observer.target
